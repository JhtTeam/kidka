# Copy this file to `.env` and fill in the keys you have.
# The .env file is gitignored.
#
# Used by `npm run generate-audio` to call the chosen TTS provider.

# ---- ElevenLabs (default provider) ----
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: override the default voice (LEnmbrrxYsUYS7vsRRwD).
# Browse the v3 voice library at https://elevenlabs.io/app/voice-library
# and paste the voiceId from the URL.
# ELEVENLABS_VOICE_ID=

# Optional: override the default model (eleven_v3).
# v3 uses inline audio tags ([slows down], [pause], [happily]…) for delivery;
# v2 (eleven_multilingual_v2) uses a `speed` slider instead — see script.
ELEVENLABS_MODEL=

# ---- Gemini (alternate provider) ----
# Get a key at https://aistudio.google.com/apikey
# Only needed when running with TTS_PROVIDER=gemini.
GEMINI_API_KEY=

# ---- Generator options ----
# TTS_PROVIDER=elevenlabs   # or `gemini`
# TTS_RPM=20                # rate limit (req/min). Default: 20 (EL) / 3 (Gemini)
# TTS_LIMIT=14              # generate only the first N phrases — smoke test
